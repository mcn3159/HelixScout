# X recent-search requires a developer bearer token.
X_BEARER_TOKEN=

# Bluesky public search needs no credentials.
ENABLE_BLUESKY=true
# Optional fallback if the public AppView is unavailable in your region. Create
# an app password in Bluesky settings; do not use your account password.
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=

# LinkedIn has no general public job-search API. This best-effort adapter reads
# public job cards only and may stop working if LinkedIn changes the page.
ENABLE_LINKEDIN_PUBLIC=true

# Optional server settings
PORT=8787
SCAN_INTERVAL_MINUTES=0
DATABASE_PATH=data/opportunities.db
